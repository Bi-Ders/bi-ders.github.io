# ---------------------------------------------------------------
# Bi Ders! ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
#
# Değerler BOŞ bırakılırsa uygulama otomatik olarak "Demo Modu"nda
# çalışır: veriler src/data/mockData.ts dosyasından okunur ve giriş
# ekranında tek tıkla Demo Öğrenci / Demo Öğretmen-Admin girişi sunulur.
# ---------------------------------------------------------------

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare R2 dosya yükleme Worker adresi (workers/r2-upload).
# Supabase yapılandırılmış canlı ortamlarda boş bırakılırsa varsayılan olarak
# https://upload.biders.org kullanılır. Yerel Worker testi için http://localhost:8787 yazabilirsiniz.
VITE_UPLOAD_API_URL=

# (İsteğe bağlı) Uygulamanın yayınlandığı tam adres. OAuth dönüş adresi
# (redirectTo) için kullanılır. Boşsa window.location.origin kullanılır.
VITE_SITE_URL=

# (İsteğe bağlı) Proje sayfası olarak yayınlıyorsanız (kullanici.github.io/repo)
# alt dizini belirtin, örn: /repo/  — bi-ders.github.io ve özel alan adı için boş bırakın.
VITE_BASE_PATH=
